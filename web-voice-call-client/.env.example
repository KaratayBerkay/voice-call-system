# Copy to .env for local `npm run dev` / `npm run build` (Vite auto-loads
# .env in this directory). Never commit the real .env.
#
# For Docker Compose, you don't need this file at all -- these values are
# derived automatically from the root .env (the same one coturn/backend
# read), see the `web` service's build.args in docker-compose.yml.

VITE_SIGNALING_URL=http://localhost:3001
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=turn:localhost:3478
VITE_TURN_USERNAME=testuser
VITE_TURN_PASSWORD=testpass
